{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",

    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,

    "sourceMap": true,
    "skipLibCheck": true,

    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"]
}
